# syntax=docker/dockerfile:1

############################
# Etapa 1: compilacion
############################
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /build

# Primero solo el pom: si no cambia, Docker reutiliza la capa de dependencias
COPY pom.xml .
RUN mvn -B -DskipTests dependency:go-offline || true

# Ahora el codigo fuente
COPY src ./src
RUN mvn -B clean package -DskipTests

############################
# Etapa 2: runtime
############################
FROM eclipse-temurin:17-jre

ARG XMX=1024m
ARG PROFILE=production

ENV XMX=$XMX \
    PROFILE=$PROFILE \
    TZ=America/Bogota

WORKDIR /app

# Usuario sin privilegios + directorios que se montan como volumenes.
# Se crean con el owner correcto para que los volumenes nombrados
# hereden esa propiedad al crearse por primera vez.
RUN useradd --system --create-home --uid 1001 cartera \
 && mkdir -p /data/firmas /data/recibos /var/log/cartera \
 && chown -R cartera:cartera /app /data /var/log/cartera

COPY --from=builder --chown=cartera:cartera \
     /build/target/cartera_temp-0.0.1-SNAPSHOT.jar /app/cartera-temporal-microservice.jar

USER cartera

EXPOSE 8021

ENTRYPOINT ["sh", "-c", "exec java -Xmx$XMX -jar /app/cartera-temporal-microservice.jar --spring.profiles.active=$PROFILE"]
